* text=auto

# O editor VBA trabalha com a codificação Windows-1252.
*.bas text working-tree-encoding=CP1252 eol=crlf

*.ps1 text eol=crlf
*.cs text eol=crlf
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.csv text eol=lf

*.xlsm binary
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary

